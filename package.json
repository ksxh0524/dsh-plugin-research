{
  "name": "dsh-plugin-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "跨域调研 DSH 插件：research_build（子代理派单闭环做 web 调研，证据行合同与 outline 引用覆盖门同源，产出 底稿/调研.md）。基建取 aivideo-core（runner 五段真源）。",
  "main": "src/cordis.ts",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "aivideo-core": "link:../aivideo-core",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.4",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,yml,yaml,html}": "prettier --write"
  }
}
