{
  "name": "dsh-plugin-research",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "通用主题式深度调研 DSH 插件：research(topic) 唯一入口（主题进报告出，零宿主概念——子代理自分解研究线→web 检索取证→自检补漏→合成带来源完整报告交回调用方）。搜索 provider 读宿主 web seam；基建取 aivideo-core（runner 五段真源）。",
  "main": "src/cordis.ts",
  "files": [
    "src",
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "aivideo-core": "link:../aivideo-core",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.4",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,yml,yaml,html}": "prettier --write"
  },
  "exports": {
    ".": "./src/cordis.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
